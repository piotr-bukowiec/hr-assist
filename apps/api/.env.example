# "development" enables TypeORM schema synchronize; "production" makes the auth cookie secure
# and disables SQL logging.
NODE_ENV=development

# HTTP port of the API (Next.js uses 3000, so keep it different). Default: 3000.
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/hr_assist

# Frontend origin allowed by CORS (with credentials)
WEB_URL=http://localhost:3000

# Secret used to sign JWTs
JWT_SECRET=change-me

# JWT lifetime (ms format, e.g. 15m, 12h, 30d). Default: 15m.
JWT_EXPIRES_IN=30d

# Pepper for argon2id password hashing. Changing it invalidates all stored passwords.
HASH_PEPPER=change-me-too

# Earliest date the app keeps records for (YYYY-MM-DD).
# Must match NEXT_PUBLIC_APP_START_DATE in apps/web/.env. Default: 2026-01-01.
APP_START_DATE=2026-01-01
