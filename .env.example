# Docker Compose substitution variables, read automatically from ./.env by `docker compose`.
# Copy to .env first: cp .env.example .env
# These only override container networking; credentials and secrets stay in apps/api/.env
# and apps/web/.env.

# Service name of the db container (the apps/api/.env host is localhost, which inside the
# api container would be the container itself)
DOCKER_POSTGRES_HOST=db
DOCKER_POSTGRES_PORT=5432

# Internal container ports. Must match the upstreams in docker/gateway.conf
# (api:3001, web:8080). The web port must not be 3000: the logout route handler calls
# NEXT_PUBLIC_API_URL server-side and would call itself in a loop.
DOCKER_API_PORT=3001
DOCKER_WEB_PORT=8080

# Public origin the browser uses (the gateway). Used as the API's CORS origin and inlined
# into the web bundle as NEXT_PUBLIC_API_URL (the gateway proxies /api/*).
DOCKER_PUBLIC_URL=http://localhost:3000
